{
  "ConnectionStrings": {
    "CncMonitoringDb": "Server=localhost;Port=3306;Database=cnc_monitoring;User Id=YOUR_MYSQL_USER;Password=YOUR_MYSQL_PASSWORD;"
  },
  "WorkerSettings": {
    "PollingIntervalSeconds": 8,
    "MaxRetryAttempts": 5,
    "RetryBaseDelaySeconds": 2
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  }
}
